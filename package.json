{
  "name": "fireside",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A cozy pixel-art simulation: a firelit clearing at night, where a last knight keeps his vigil and a village of shroomfolk tends the fire.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "smoke": "node scripts/run.mjs scripts/smoke.ts",
    "share-images": "node scripts/run.mjs scripts/share-images.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
